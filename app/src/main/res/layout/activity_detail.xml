<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة تفاصيل الحالة (البروتوكول) — إعادة تصميم كاملة.
     العنوان صار ظاهرًا (كان android:title مُهمَلًا في MaterialToolbar فيظهر
     الشريط فارغًا)، والمحتوى يُبنى بطبقات واضحة: عنوان + إعدادات الجهاز +
     وضع الأقطاب + الشرح + السلامة + الإجراءات، وكله محاذى لليمين بشكل صحيح.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_arrow_back">

        <TextView
            android:layout_gravity="center"
            style="@style/Phizyo.HeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تفاصيل الحالة" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/detail_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp" />
    </ScrollView>
</LinearLayout>
