<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/btn_assign_patient"
        style="@style/Phizyo.Button.Primary"
        android:text="إسناد البرنامج لمريض" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_program_edit"
            style="@style/Phizyo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_secondary"
            android:text="تعديل" />

        <TextView
            android:id="@+id/btn_program_delete"
            style="@style/Phizyo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_trash"
            android:drawablePadding="8dp"
            android:drawableTint="@color/accent_red"
            android:text="حذف"
            android:textColor="@color/accent_red" />
    </LinearLayout>
</LinearLayout>
