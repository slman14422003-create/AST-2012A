<?xml version="1.0" encoding="utf-8"?>
<!-- إضافة / تعديل برنامج علاج فيزيائي — نموذج بأسلوب Claude -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_close"
        app:title="برنامج علاج فيزيائي جديد" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="خطة علاج طبيعي متكاملة (مش مرتبطة بجهاز معيّن) — تقدر تستخدمها كمرجع أو تطبعها/تشاركها مع المريض."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="14sp" />

            <TextView
                style="@style/Phizyo.FormSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="عن البرنامج" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="عنوان البرنامج *" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_title"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textCapSentences" />

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="التشخيص (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_diagnosis"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textCapSentences" />

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الأهداف العلاجية (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_goals"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:minLines="3" />
            </LinearLayout>

            <TextView
                style="@style/Phizyo.FormSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="الخطة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="مراحل البرنامج / خطة الجلسات (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_phases"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:minLines="4" />

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="التمارين الموصى بها (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_exercises"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:minLines="4" />
            </LinearLayout>

            <TextView
                style="@style/Phizyo.FormSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="السلامة والملاحظات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="احتياطات وتحذيرات (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_precautions"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:minLines="3" />

                <TextView
                    style="@style/Phizyo.FormLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ملاحظات إضافية (اختياري)" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tp_notes"
                    style="@style/Phizyo.FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:minLines="3" />
            </LinearLayout>

                <TextView
                    android:id="@+id/btn_submit_program"
                    style="@style/Phizyo.PillPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="حفظ البرنامج" />

                <TextView
                    android:id="@+id/btn_cancel_program"
                    style="@style/Phizyo.PillSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="إلغاء" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
