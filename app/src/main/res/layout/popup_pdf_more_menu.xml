<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى قائمة "المزيد" في قارئ PDF: بطاقة زجاجية (bg_popup_menu - نفس
     تعبئة/حدود بطاقات التطبيق) تحوي صفوفًا بنفس نمط Settings.Row/
     Settings.RowIcon/Settings.Divider المستخدم في شاشة الإعدادات وبقية
     قوائم التطبيق - بدل الاعتماد على قائمة Android الافتراضية اللي مش
     دايمًا بتلتزم بألوان/شكل هوية التطبيق على كل الأجهزة. تُعرض داخل
     PopupWindow مخصّص من PdfViewerActivity (انظر showMoreMenu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/row_pdf_translate_page"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_globe" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترجمة الصفحة"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_translate_full"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_pdf" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترجمة الملف بالكامل (PDF)"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_save_copy"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_download" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ نسخة على الجهاز"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_night_pages"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_moon" />

        <TextView
            android:id="@+id/txt_pdf_night_pages"
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الوضع الليلي للصفحات"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_goto"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الانتقال إلى صفحة"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_open_external"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_share_out" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فتح بتطبيق آخر"
            android:textSize="14.5sp" />
    </LinearLayout>

    <View style="@style/Settings.Divider" />

    <LinearLayout
        android:id="@+id/row_pdf_pick_another"
        style="@style/Settings.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">

        <ImageView
            style="@style/Settings.RowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_folder" />

        <TextView
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فتح ملف PDF آخر"
            android:textSize="14.5sp" />
    </LinearLayout>

</LinearLayout>
