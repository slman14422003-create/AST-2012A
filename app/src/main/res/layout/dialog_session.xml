<?xml version="1.0" encoding="utf-8"?>
<!-- نافذة تسجيل/تعديل جلسة -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/dlg_title"
            style="@style/Phizyo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/dlg_date"
            style="@style/Phizyo.Button.Secondary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Phizyo.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="البروتوكول المستخدم">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dlg_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="text"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="14.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="المدة (دقيقة)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="رسم الجلسة">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="الألم قبل (0–10)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_pain_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="الألم بعد (0–10)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_pain_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Phizyo.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="ملاحظات الجلسة">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dlg_save"
                style="@style/Phizyo.Button.Primary"
                android:layout_width="0dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="حفظ" />

            <TextView
                android:id="@+id/dlg_cancel"
                style="@style/Phizyo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="إلغاء" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
