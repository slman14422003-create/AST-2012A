<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_dark"
            android:title="@string/app_name"
            android:titleTextColor="@color/text_primary"
            app:menu="@menu/menu_main" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:hint="ابحث عن حالة، عرض، أو مشكلة..."
            app:boxBackgroundColor="@color/surface_dark"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/primary_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:gravity="end"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_my_cases"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗂️ حالاتي"
                android:textColor="@color/primary_cyan" />

            <Button
                android:id="@+id/btn_encyclopedia"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 موسوعة الأنماط"
                android:textColor="@color/primary_cyan" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="المنظومة السريرية الضخمة جاهزة الآن.\nابحث عن أي حالة، نمط، أو مشكلة تقنية للحصول على التوصيف الدقيق."
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/result_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/accent_green"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="90dp" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:contentDescription="إضافة حالة جديدة"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/primary_cyan"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
