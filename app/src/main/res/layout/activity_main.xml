<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     الشاشة الرئيسية — إعادة تصميم بأسلوب تطبيق Claude:
     * شريط علوي: شعار صغير + اسم التطبيق + زر الإعدادات (أيقونة)
     * شاشة ترحيبية: نجمة كبيرة + عبارة ترحيب serif + اقتراحات كصفوف كبسولة
     * أسفل الشاشة: اختصارات بأيقونات (بدل الإيموجي) + حقل بحث كبسولة + زر "+"
     كل المعرّفات (IDs) التي يعتمد عليها MainActivity.java أُبقيت كما هي.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <!-- ============== الشريط العلوي ============== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_top_bar_modern"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_avatar_gradient">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pulse"
                android:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="Phizyo Studio"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_cloud_storage"
            style="@style/Phizyo.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="الملفات السحابية"
            android:src="@drawable/ic_cloud" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/Phizyo.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="الإعدادات"
            android:src="@drawable/ic_sliders" />
    </LinearLayout>

    <!-- ============== منطقة المحتوى (مرنة) ============== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- حالة فارغة: ترحيب + عمليات بحث سابقة + أمثلة -->
        <ScrollView
            android:id="@+id/empty_hint_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minHeight="360dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="32dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/claude_orange" />

                <!-- عبارة الترحيب المتغيّرة (يعبّئها MainActivity من GreetingProvider) -->
                <TextView
                    android:id="@+id/empty_hint_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="بماذا تفكر؟"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="ابحث عن أي حالة، نمط، أو مشكلة تقنية للحصول على التوصيف الدقيق."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="14.5sp" />

                <!-- بطاقة "المرضى": دائمة الظهور أعلى شاشة الترحيب، المرضى مرتّبون
                     حسب المواعيد (اليوم أولًا ثم القادم) - يعبّئها
                     MainActivity.loadPatientsPreview(). -->
                <LinearLayout
                    android:id="@+id/today_patients_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_users"
                            android:tint="@color/primary_cyan" />

                        <TextView
                            android:id="@+id/today_patients_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="المرضى"
                            android:textAlignment="viewStart"
                            android:textColor="@color/text_primary"
                            android:textDirection="rtl"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            style="@style/Settings.RowChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/today_patients_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recent_searches_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="10dp"
                        android:text="عمليات بحث سابقة"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_tertiary"
                        android:textDirection="rtl"
                        android:textSize="13sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/recent_searches_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="10dp"
                    android:text="جرّب أحد هذه الأمثلة"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_tertiary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_suggestion_1"
                    style="@style/SuggestionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عرق النسا" />

                <TextView
                    android:id="@+id/chip_suggestion_2"
                    style="@style/SuggestionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الكتف المتجمد" />

                <TextView
                    android:id="@+id/chip_suggestion_3"
                    style="@style/SuggestionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="النفق الرسغي" />

                <TextView
                    android:id="@+id/chip_suggestion_4"
                    style="@style/SuggestionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اسفل الظهر" />
            </LinearLayout>
        </ScrollView>

        <!-- حالة النتائج / الرد المباشر من المساعد -->
        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/result_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:textAlignment="viewStart"
                android:textColor="@color/accent_green"
                android:textDirection="rtl"
                android:textSize="13.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/suggestion_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:drawableStart="@drawable/ic_bulb"
                android:drawablePadding="8dp"
                android:drawableTint="@color/accent_gold"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="13.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_ask_ai_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_accent"
                android:clickable="true"
                android:drawableStart="@drawable/ic_sparkle"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                android:text="اسأل Phizyo AI بدل ذلك"
                android:textColor="@color/white"
                android:textDirection="rtl"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ai_inline_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminateTint="@color/claude_orange" />

                <TextView
                    android:id="@+id/ai_inline_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Phizyo AI يفكر..."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="14sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/ai_inline_answer_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sparkle"
                            android:tint="@color/claude_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="رد Phizyo AI"
                            android:textColor="@color/text_secondary"
                            android:textDirection="rtl"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ai_inline_answer_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="6dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textIsSelectable="true"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ai_inline_open_chat"
                            style="@style/Phizyo.NavChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="8dp"
                            android:drawableStart="@drawable/ic_message_circle"
                            android:text="متابعة المحادثة" />

                        <TextView
                            android:id="@+id/ai_inline_save_case"
                            style="@style/Phizyo.NavChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_bookmark"
                            android:text="حفظ كحالة" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/results_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ============== الرصيف السفلي: اختصارات + حقل البحث ============== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_dock_modern"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/btn_ai_assistant"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_accent"
                    android:drawableStart="@drawable/ic_sparkle"
                    android:drawableTint="@color/white"
                    android:text="Phizyo AI"
                    android:textColor="@color/white"
                    android:textDirection="ltr"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_favorites"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_star_stroke"
                    android:text="المفضلة" />

                <TextView
                    android:id="@+id/btn_my_cases"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="حالاتي" />

                <TextView
                    android:id="@+id/btn_encyclopedia"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_book"
                    android:text="موسوعة الأنماط" />

                <TextView
                    android:id="@+id/btn_anatomy"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_body"
                    android:text="دليل التشريح" />

                <TextView
                    android:id="@+id/btn_patients"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_users"
                    android:text="المرضى" />

                <TextView
                    android:id="@+id/btn_treatment_programs"
                    style="@style/Phizyo.NavChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_clipboard"
                    android:text="برامج العلاج" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- شريط البحث: زر "+" دائري + حقل بحث كبسولة (مثل شريط Claude) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/fab_add"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_add_button"
                android:contentDescription="إضافة حالة جديدة"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus"
                android:tint="@color/text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_composer"
                app:boxBackgroundMode="none"
                app:endIconMode="clear_text"
                app:endIconTint="@color/text_tertiary"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="ابحث عن حالة، عرض، أو مشكلة..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:minHeight="52dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textDirection="rtl"
                    android:textSize="15.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
