<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     الشاشة الرئيسية — إعادة بناء كاملة من الصفر بأسلوب Claude:
     شريط علوي رفيع شبه شفاف + منطقة محتوى مرنة (حالة ترحيب فارغة أو نتائج)
     + "رصيف" سفلي ثابت يحوي اختصارات التنقل ثم شريط البحث نفسه، بدل الرأس
     الزجاجي الضخم القديم اللي كان شريط البحث فيه أعلى الشاشة.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <!-- ============== الشريط العلوي: إعادة تصميم v2 ==============
         بطاقة عائمة بزوايا سفلية أوسع (26dp) وحد خفيف كامل بدل الظل وحده،
         شعار بتدرج لوني بدل التعبئة المسطحة القديمة، ونقطة الحالة الخضراء
         انتقلت لتلتصق بزاوية الشعار نفسه (بدل نقطة تمييز منفصلة بجانب
         العنوان) لتوحي بـ"جاهز الآن" بدل مجرد زخرفة. زر الإعدادات بقى
         دائرة أكبر شوي بحدّ أوضح مع تأثير ripple عند الضغط. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar_modern"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <!-- شعار دائري بتدرج + نقطة حالة صغيرة في الزاوية -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_gradient">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🩺"
                    android:textSize="19sp" />
            </FrameLayout>

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dot_accent" />
        </FrameLayout>

        <!-- عنوان + عنوان فرعي -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.005"
                android:text="Phizyo Studio"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- عبارة ترحيب قصيرة تتغيّر حسب وقت اليوم (GreetingProvider)
                 تُملأ من MainActivity. -->
            <TextView
                android:id="@+id/header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="مساعد العلاج الطبيعي الذكي"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- زر الإعدادات: دائرة واضحة بحدّ وripple - الثيم بقى داخل
             الإعدادات بس (المظهر). -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_card_pressed"
            android:contentDescription="المزيد والإعدادات"
            android:padding="11dp"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <!-- ============== منطقة المحتوى (مرنة) ============== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- حالة فارغة: ترحيب بأسلوب Claude Home + أمثلة + عمليات بحث سابقة -->
        <ScrollView
            android:id="@+id/empty_hint_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="360dp"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.9"
                    android:text="🩺"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/empty_hint_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="بماذا تفكر؟"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="ابحث عن أي حالة، نمط، أو مشكلة تقنية للحصول على التوصيف الدقيق."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:id="@+id/recent_searches_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:layout_marginBottom="8dp"
                        android:text="🕘 عمليات بحث سابقة"
                        android:textColor="@color/text_tertiary"
                        android:textDirection="rtl"
                        android:textSize="11sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/recent_searches_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="8dp"
                    android:text="جرّب أحد هذه الأمثلة"
                    android:textColor="@color/text_tertiary"
                    android:textDirection="rtl"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_suggestion_1"
                                style="@style/SuggestionChip"
                                android:text="عرق النسا" />

                            <TextView
                                android:id="@+id/chip_suggestion_2"
                                style="@style/SuggestionChip"
                                android:text="الكتف المتجمد" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_suggestion_3"
                                style="@style/SuggestionChip"
                                android:text="النفق الرسغي" />

                            <TextView
                                android:id="@+id/chip_suggestion_4"
                                style="@style/SuggestionChip"
                                android:text="اسفل الظهر" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- حالة النتائج / الرد المباشر من المساعد -->
        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/result_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/accent_green"
                android:textDirection="rtl"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/suggestion_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp"
                android:paddingVertical="9dp"
                android:textColor="@color/accent_gold"
                android:textDirection="rtl"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_ask_ai_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_chip_accent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="✨ اسأل Phizyo AI بدل ذلك"
                android:textColor="@color/white"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ai_inline_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/primary_cyan" />

                <TextView
                    android:id="@+id/ai_inline_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Phizyo AI يفكر..."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/ai_inline_answer_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="end"
                        android:text="✨ رد Phizyo AI"
                        android:textColor="@color/primary_cyan_dark"
                        android:textDirection="rtl"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ai_inline_answer_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/glass_border_soft" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/ai_inline_save_case"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="➕ حفظ كحالة"
                            android:textColor="@color/primary_cyan_dark"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/ai_inline_open_chat"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💬 متابعة المحادثة"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/results_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ============== الرصيف السفلي الثابت: اختصارات + شريط البحث ==============
         إعادة تصميم v2: مقبض صغير علوي (sheet handle) يفصل بصريًا بين
         منطقة المحتوى والرصيف الثابت، زوايا علوية أوسع (28dp) + حدّ رفيع
         محيط بدل الاعتماد على الظل فقط، ومسافات أوسع بين الرقائق. تبويب
         "Phizyo AI" بقى بتعبئة خفيفة + حدّ بلون التمييز بدل التعبئة
         المصمتة الكاملة، حتى يبرز كأهم اختصار دون أن يطغى بصريًا. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_dock_modern"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/dot_handle" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/btn_ai_assistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_chip_accent_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="✨ Phizyo AI"
                    android:textColor="@color/primary_cyan_dark"
                    android:textDirection="rtl"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="⭐ المفضلة"
                    android:textColor="@color/accent_gold"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_my_cases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="🗂️ حالاتي"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_encyclopedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="📖 موسوعة الأنماط"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_anatomy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="🦴 دليل التشريح"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_patients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="🧑‍⚕️ المرضى"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_treatment_programs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/bg_glass_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="📋 برامج العلاج"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- شريط البحث نفسه: صف واحد ثابت أسفل الشاشة، زر الإضافة + الحقل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="16dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_add"
                style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Primary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="إضافة حالة جديدة"
                android:text="حالة جديدة"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_cyan"
                app:cornerRadius="23dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white"
                app:pressedTranslationZ="2dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ابحث عن حالة، عرض، أو مشكلة..."
                app:boxBackgroundColor="@color/glass_fill_soft"
                app:boxCornerRadiusBottomEnd="22dp"
                app:boxCornerRadiusBottomStart="22dp"
                app:boxCornerRadiusTopEnd="22dp"
                app:boxCornerRadiusTopStart="22dp"
                app:boxStrokeColor="@color/primary_cyan"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.6dp"
                app:hintTextColor="@color/text_tertiary"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_tertiary"
                app:endIconMode="clear_text"
                app:endIconTint="@color/text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
