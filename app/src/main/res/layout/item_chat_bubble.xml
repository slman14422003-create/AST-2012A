<?xml version="1.0" encoding="utf-8"?>
<!-- فقاعة رسالة الدردشة — إعادة بناء: رسالة المستخدم في فقاعة بيج فاتحة،
     ورد المساعد كنص مباشر بدون فقاعة (بنفس أسلوب Claude)، مع شارة مصدر
     واضحة أسفل كل رد يستند لمصدر خارجي. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/bubble_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bubble_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubble_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/bubble_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/bubble_avatar_frame"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/bubble_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/bubble_avatar_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/ai_assistant_name"
                    android:src="@drawable/ic_ai_bot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:lineSpacingExtra="3dp"
            android:maxWidth="300dp"
            android:padding="13dp"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bubble_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_source_chip"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:maxWidth="300dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textColor="@color/m3_on_primary_container"
            android:textDirection="rtl"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bubble_regenerate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 إعادة المحاولة"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/bubble_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 نسخ"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/bubble_save_case"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕ حفظ كحالة جديدة"
                android:textAllCaps="false"
                android:textColor="@color/primary_cyan_dark"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
