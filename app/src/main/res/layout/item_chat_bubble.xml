<?xml version="1.0" encoding="utf-8"?>
<!-- رسالة في محادثة Phizyo AI — بأسلوب Claude:
     * رسالة المستخدم: فقاعة بيج مدوّرة (bubble_user_text)
     * رد المساعد: نص مباشر بدون فقاعة (bubble_ai_text) + شارة مصدر (bubble_source)
       + صف أدوات صغير: نجمة + نسخ + إعادة المحاولة + حفظ كحالة
     بدون صورة رمزية ولا اسم ولا وقت لكل رسالة. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="22dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bubble_user_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_bubble_user"
        android:lineSpacingExtra="4dp"
        android:maxWidth="310dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_primary"
        android:textDirection="rtl"
        android:textIsSelectable="true"
        android:textSize="15.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubble_ai_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubble_ai_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bubble_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_source_chip"
            android:clickable="true"
            android:drawableStart="@drawable/ic_book"
            android:drawablePadding="8dp"
            android:drawableTint="@color/m3_on_primary_container"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:maxWidth="320dp"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:textColor="@color/m3_on_primary_container"
            android:textDirection="rtl"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                android:tint="@color/claude_orange" />

            <ImageButton
                android:id="@+id/bubble_copy"
                style="@style/Phizyo.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="نسخ"
                android:padding="10dp"
                android:src="@drawable/ic_copy_out"
                android:tint="@color/text_secondary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/bubble_regenerate"
                style="@style/Phizyo.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="إعادة المحاولة"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bubble_save_case"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_bookmark"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="حفظ كحالة"
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
