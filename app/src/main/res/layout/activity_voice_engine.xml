<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة إعدادات محرك الصوت البشري: نمط جاهز + منزلقات الإيقاع + مفاتيح التفاصيل + التعلّم + تجربة فورية. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="محرك الصوت البشري" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Settings.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="المحرك" />

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/row_engine_on"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_volume" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تفعيل الإيقاع البشري" />

                        <TextView
                            android:id="@+id/engine_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="يضبط نغمة وسرعة ووقفات كل جملة على حدة" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_engine_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_preset"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sliders" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نمط القراءة" />

                        <TextView
                            android:id="@+id/preset_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="متوازن (إنساني)" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Settings.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الإيقاع" />

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="التنويع الطبيعي بين الجمل" />

                        <TextView
                            android:id="@+id/natural_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_natural"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="التعبير (نغمة السؤال والعناوين)" />

                        <TextView
                            android:id="@+id/express_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_express"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="طول الوقفات" />

                        <TextView
                            android:id="@+id/pause_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_pause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="150" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="إزاحة السرعة" />

                        <TextView
                            android:id="@+id/rate_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="60" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="إزاحة طبقة الصوت" />

                        <TextView
                            android:id="@+id/pitch_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_pitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="40" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Settings.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تفاصيل الأداء" />

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/row_question"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pulse" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نغمة السؤال والتعجب" />

                        <TextView
                            android:id="@+id/q_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ترفع الصوت عند ؟ و !" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_question"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_heading"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pin" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="أسلوب العناوين" />

                        <TextView
                            android:id="@+id/h_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="العبارات القصيرة بلا نقطة تُقرأ أبطأ وأهدأ مع وقفة أطول" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_paren"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="أسلوب ما بين الأقواس" />

                        <TextView
                            android:id="@+id/p_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تُقرأ بنبرة أخفض وأسرع قليلًا" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_paren"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_breath"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wifi" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="وقفات التقاط النفَس" />

                        <TextView
                            android:id="@+id/b_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="وقفة قصيرة طبيعية بعد الجمل والفواصل" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_breath"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Settings.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التعلّم الذكي" />

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/row_learn"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_zap" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="التعلّم من طريقة استماعك" />

                        <TextView
                            android:id="@+id/learn_stats"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_learn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_ai_tutor"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sparkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تدريب النطق بالذكاء الاصطناعي" />

                        <TextView
                            android:id="@+id/ai_tutor_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="يرسل كلمات مفردة فقط (بدون جمل) ويعرض اقتراحاته لتوافق عليها" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_dicts"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_book" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="القواميس المدمجة ومكتبات الكلمات" />

                        <TextView
                            android:id="@+id/dict_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/row_reset_learning"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_refresh" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="مسح تعلّم السلوك" />

                        <TextView
                            android:id="@+id/reset_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="يصفّر الإحصاءات والكلمات المشتبه بها فقط" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Settings.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تجربة الصوت" />

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <EditText
                    android:id="@+id/sample_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_outline"
                    android:gravity="top|start"
                    android:hint="اكتب جملة لتجربتها"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="14dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="تجربة الصوت" />

                <TextView
                    android:id="@+id/test_status"
                    style="@style/Settings.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
