<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة الإعدادات — إعادة بناء كاملة: مجموعات بطاقات بيضاء نظيفة بعناوين
     أقسام واضحة، بدل الأزرار المتفرقة المتراصة القديمة، بأسلوب أقرب لصفحة
     إعدادات Claude/iOS.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_container"
        android:title="المزيد والإعدادات"
        android:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_close" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============== قسم: المظهر ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🌓 المظهر" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_theme_mode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🌓 حسب إعداد الجهاز - اضغط للتبديل"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: الإشعارات ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🔔 الإشعارات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🔕 الإشعارات غير مفعّلة - اضغط للتفعيل"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: المساعد الذكي ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🤖 المساعد الذكي" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="كيف يعمل المساعد الذكي؟"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="1️⃣ أي سؤال يطابق قاعدة بيانات الجهاز (130 حالة موثقة) يُجاب فورًا من البيانات نفسها بدون إنترنت وبدقة 100%.&#10;&#10;2️⃣ غير ذلك، يُستخدم بحث ويكيبيديا (عربي ثم إنجليزي) كخلفية معرفية عامة تكميلية، وتُعرض دائمًا بشارة مصدر واضحة مميّزة عن بيانات الجهاز.&#10;&#10;3️⃣ الصياغة النهائية تمرّ على مزوّد ذكاء اصطناعي مجاني بالكامل بدون مفتاح (بالتناوب التلقائي بين أكثر من مزوّد لضمان الاستمرارية) — لا يلزمك أي اشتراك أو تسجيل."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:gravity="end"
                android:padding="12dp"
                android:text="⚙️ تقدر (اختياريًا) تضيف مفتاح API مجاني من openrouter.ai لتجربة نموذج بديل بدل السلسلة المجانية الافتراضية.&#10;⚠️ الصق المفتاح فقط (يبدأ بـ sk-or-v1-...) — بدون كتابة export ولا أي أوامر.&#10;&#10;🔒 المفتاح يُحفظ على جهازك فقط، ولا يُرسَل لأي مكان غير OpenRouter مباشرة.&#10;🔁 لو ظهرت رسالة أن المفتاح غير صالح أو انتهت صلاحيته، أعد إصداره من openrouter.ai/keys — التطبيق يرجع تلقائيًا للوضع المجاني بدون مفتاح لو حصل أي عطل مؤقت في مفتاحك."
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="مفتاح API اختياري (OpenRouter)"
                app:boxBackgroundColor="@color/glass_fill_soft"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/primary_cyan"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ai_key_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_key"
                style="@style/PrimaryButton"
                android:layout_marginBottom="10dp"
                android:text="💾 حفظ المفتاح" />

            <!-- تعليمات مخصّصة للمساعد الذكي: المستخدم يقدر "يدرّبه" حسب
                 طلبه (أسلوب الإجابة، تركيز معيّن، تفضيلات...) وتُضاف تلقائيًا
                 لتعليمات النظام في كل محادثة (المحادثة الكاملة والرد السريع). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:text="🎓 تعليمات مخصّصة للمساعد الذكي (اختياري)"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="end"
                android:text="مثال: ركّز دايمًا على التمارين المنزلية، أو اجعل الإجابات مختصرة جدًا بنقاط، أو اسأل عن عمر المريض قبل أي اقتراح."
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="تعليماتك للمساعد الذكي">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ai_custom_instructions_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3"
                    android:textDirection="rtl" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_instructions"
                style="@style/GlassButton"
                android:layout_marginBottom="26dp"
                android:text="✅ حفظ التعليمات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_clear_chat_history"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🗑️ مسح سجل محادثة المساعد الذكي"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: الحالات المخصصة ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🗂️ الحالات المخصصة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_export"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="⬇️ تصدير نسخة احتياطية من حالاتي"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_clear_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🗑️ مسح كل الحالات المخصصة"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_red"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: عن التطبيق ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="ℹ️ عن التطبيق" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_about"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="نبذة عن التطبيق والإصدار"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
