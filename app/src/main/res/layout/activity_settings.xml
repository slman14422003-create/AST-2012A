<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة الإعدادات — إعادة تصميم بأسلوب تطبيق Claude:
     * شريط علوي بسيط (سهم رجوع + عنوان في المنتصف)
     * بطاقة Phizyo AI في الأعلى (مثل بطاقة "Want more Claude?") فيها زر
       اختبار الاتصال
     * مجموعات صفوف مدوّرة، كل صف: أيقونة + عنوان + وصف اختياري + سهم/قيمة
     * حُذفت العناصر غير الضرورية: مشاركة التطبيق، تقييم التطبيق، التواصل،
       رابط الووركر، بطاقة الشرح الطويلة (صارت صفًا يفتح نافذة).
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="الإعدادات" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- ============== بطاقة Phizyo AI ============== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Phizyo AI"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="مساعدك الذكي للعلاج الطبيعي. تأكد أنه متصل ويعمل بشكل صحيح."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_test_worker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_pill_inverse"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="اختبار الاتصال"
                    android:textColor="@color/bg_deep_1"
                    android:textDirection="rtl"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_ai_instructions"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sparkle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تعليمات مخصّصة" />

                        <TextView
                            android:id="@+id/ai_instructions_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="غير مضبوطة" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_ai_how"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_help" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="كيف يعمل Phizyo AI؟" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_clear_chat_history"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_trash" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="مسح سجل المحادثة" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_theme_mode"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_moon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="المظهر" />

                        <TextView
                            android:id="@+id/theme_value"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="حسب الجهاز" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_notif"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bell" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الإشعارات" />

                        <TextView
                            android:id="@+id/notif_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="غير مفعّلة" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_notif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_export"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="تصدير نسخة احتياطية" />

                        <TextView
                            android:id="@+id/export_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="من حالاتي المخصصة" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_clear_all"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_trash"
                        android:tint="@color/accent_red" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="مسح كل الحالات المخصصة"
                            android:textColor="@color/accent_red" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============== النسخ السحابي (Firebase Firestore) ============== -->
            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_cloud_account"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="حساب النسخ السحابي" />

                        <TextView
                            android:id="@+id/cloud_account_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_cloud_auto_backup"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cloud" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نسخ احتياطي سحابي للمرضى" />

                        <TextView
                            android:id="@+id/cloud_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="غير مفعّل" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_cloud_auto_backup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_cloud_backup_now"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download"
                        android:rotation="180" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="نسخ احتياطي الآن" />

                        <TextView
                            android:id="@+id/cloud_backup_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="لم يتم الرفع بعد" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_cloud_restore"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="استعادة من السحابة" />

                        <TextView
                            android:id="@+id/cloud_restore_sub"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="لم تتم الاستعادة بعد" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Settings.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/btn_check_update"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="التحقق من التحديثات" />

                        <TextView
                            android:id="@+id/update_status"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_about"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="عن التطبيق" />

                        <TextView
                            android:id="@+id/settings_version_label"
                            style="@style/Settings.RowSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>

                <View
                    style="@style/Settings.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btn_privacy_policy"
                    style="@style/Settings.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/Settings.RowIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Settings.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="سياسة الخصوصية" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Settings.RowChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
