<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة الإعدادات — إعادة بناء كاملة: مجموعات بطاقات بيضاء نظيفة بعناوين
     أقسام واضحة، بدل الأزرار المتفرقة المتراصة القديمة، بأسلوب أقرب لصفحة
     إعدادات Claude/iOS.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_container"
        android:title="المزيد والإعدادات"
        android:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_close" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============== قسم: المظهر ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🌓 المظهر" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_theme_mode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🌓 حسب إعداد الجهاز - اضغط للتبديل"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: الإشعارات ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🔔 الإشعارات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🔕 الإشعارات غير مفعّلة - اضغط للتفعيل"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: Phizyo AI ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🤖 Phizyo AI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="كيف يعمل Phizyo AI؟"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="1️⃣ أي سؤال يطابق قاعدة بيانات الجهاز (130 حالة موثقة) يُجاب فورًا من البيانات نفسها بدون إنترنت وبدقة 100%.&#10;&#10;2️⃣ غير ذلك، يُستخدم بحث Physiopedia أولًا (مرجع متخصص في العلاج الطبيعي مراجَع من أخصائيين)، ثم ويكيبيديا (عربي ثم إنجليزي) كخلفية معرفية عامة تكميلية لو مفيش نتيجة.&#10;&#10;3️⃣ الصياغة النهائية تتم دائمًا عبر Phizyo AI - مزوّد ذكاء اصطناعي واحد ثابت مبني داخل التطبيق، وتلتزم بأي تعليمات مخصّصة تضيفها تحت."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- رابط الووركر ثابت داخل التطبيق (AiClient.FIXED_WORKER_URL) وغير
                 قابل للتعديل من هنا - معروض هنا للشفافية فقط، مع زر اختبار
                 اتصال فوري. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="☁️ المزوّد الثابت (Cloudflare Worker)"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/worker_url_fixed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_test_worker"
                style="@style/PrimaryButton"
                android:layout_marginBottom="22dp"
                android:text="🧪 اختبار الاتصال" />

            <!-- تعليمات مخصّصة لـ Phizyo AI: المستخدم يقدر "يدرّبه" حسب طلبه
                 (أسلوب الإجابة، تركيز معيّن، تفضيلات...) وتُضاف تلقائيًا
                 لتعليمات النظام في كل محادثة (المحادثة الكاملة والرد السريع). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:text="🎓 تعليمات مخصّصة لـ Phizyo AI (اختياري)"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="end"
                android:text="مثال: ركّز دايمًا على التمارين المنزلية، أو اجعل الإجابات مختصرة جدًا بنقاط، أو اسأل عن عمر المريض قبل أي اقتراح."
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="تعليماتك لـ Phizyo AI">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ai_custom_instructions_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3"
                    android:textDirection="rtl" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_instructions"
                style="@style/GlassButton"
                android:layout_marginBottom="26dp"
                android:text="✅ حفظ التعليمات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_clear_chat_history"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🗑️ مسح سجل محادثة Phizyo AI"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: الحالات المخصصة ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🗂️ الحالات المخصصة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_export"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="⬇️ تصدير نسخة احتياطية من حالاتي"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_clear_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🗑️ مسح كل الحالات المخصصة"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_red"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: ميزات إضافية ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="⭐ ميزات إضافية" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_share_app"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="📤 مشاركة التطبيق"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_rate_app"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="⭐ قيّم التطبيق"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_feedback"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="✉️ تواصل معنا / أرسل ملاحظات"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ============== قسم: عن التطبيق ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="ℹ️ عن التطبيق" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_about"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="نبذة عن التطبيق والإصدار"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_privacy_policy"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="end|center_vertical"
                    android:paddingVertical="12dp"
                    android:text="🔒 سياسة الخصوصية"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
