<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة الإعدادات — إعادة تصميم v3: نفس منطق v2 (عنوان serif + بطاقة هوية
     + مجموعات أقسام) لكن بترتيب منطقي أوضح: عام (المظهر + الإشعارات) أولًا،
     ثم Phizyo AI كقسم واحد متكامل (شرح + حالة الاتصال + التعليمات
     المخصّصة + مسح السجل مجمّعين تحت نفس العنوان بدل التفرّق)، ثم البيانات،
     ثم الدعم، وأخيرًا "عن التطبيق" كصف واحد فقط بدل التكرار القديم (كان
     فيه عنوان قسم "ℹ️ عن التطبيق" + زر "نبذة عن التطبيق والإصدار" بداخله -
     نفس المعنى مرتين. الآن سياسة الخصوصية انضمت لنفس البطاقة تحت عنوان
     القسم مباشرة، بدون عنصر وسيط مكرر).
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_top_bar_modern"
        android:elevation="0dp"
        app:contentInsetStart="20dp"
        app:navigationIcon="@drawable/ic_close">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="الإعدادات"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="21sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============== بطاقة الهوية العلوية ============== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="end"
                        android:text="Phizyo Studio"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_version_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="end"
                        android:textColor="@color/text_tertiary"
                        android:textDirection="rtl"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_avatar_gradient">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🩺"
                        android:textSize="22sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- ============== قسم: عام (المظهر + الإشعارات) ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="⚙️ عام" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_theme_mode"
                    style="@style/SettingsRow"
                    android:text="🌓 حسب إعداد الجهاز" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/SettingsRow"
                    android:text="🔕 الإشعارات غير مفعّلة - اضغط للتفعيل" />
            </LinearLayout>

            <!-- ============== قسم: Phizyo AI (مجمّع بالكامل) ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="✨ Phizyo AI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="كيف يعمل Phizyo AI؟"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_avatar_circle_ai_gradient">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="✨"
                            android:textSize="13sp" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:lineSpacingExtra="3dp"
                    android:text="1️⃣ Phizyo AI نفسه هو اللي بيقرر - لكل رسالة على حدة - هل محتاج يبحث ولا لأ. لو الرسالة دردشة عادية بيرد عليك طبيعي على طول بدون أي بحث.&#10;&#10;2️⃣ لو الرسالة سؤال إكلينيكي فعلي، بيتحقق الأول من قاعدة بيانات الجهاز (130 حالة موثقة) - تطابق مباشر منها يُجاب فورًا وبدقة 100% بدون إنترنت.&#10;&#10;3️⃣ غير كده، يُستخدم بحث Physiopedia أولًا (مرجع متخصص في العلاج الطبيعي)، ثم ويكيبيديا كخلفية معرفية عامة تكميلية لو مفيش نتيجة - والصياغة النهائية دائمًا عبر Phizyo AI، وتلتزم بأي تعليمات مخصّصة تضيفها تحت."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- رابط الووركر ثابت داخل التطبيق (AiClient.FIXED_WORKER_URL) وغير
                 قابل للتعديل من هنا - معروض هنا للشفافية فقط، مع زر اختبار
                 اتصال فوري بنفس البطاقة. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="☁️ المزوّد الثابت (Cloudflare Worker)"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/worker_url_fixed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_test_worker"
                    style="@style/PrimaryButton"
                    android:layout_height="48dp"
                    android:text="🧪 اختبار الاتصال" />
            </LinearLayout>

            <!-- تعليمات مخصّصة لـ Phizyo AI: المستخدم يقدر "يدرّبه" حسب طلبه
                 (أسلوب الإجابة، تركيز معيّن، تفضيلات...) وتُضاف تلقائيًا
                 لتعليمات النظام في كل محادثة (المحادثة الكاملة والرد السريع). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="🎓 تعليمات مخصّصة (اختياري)"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="end"
                    android:text="مثال: ركّز دايمًا على التمارين المنزلية، أو اجعل الإجابات مختصرة جدًا بنقاط."
                    android:textColor="@color/text_tertiary"
                    android:textDirection="rtl"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="تعليماتك لـ Phizyo AI"
                    app:boxBackgroundColor="@color/glass_fill">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ai_custom_instructions_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:minLines="3"
                        android:textDirection="rtl" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_save_instructions"
                    style="@style/GlassButton"
                    android:text="✅ حفظ التعليمات" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_clear_chat_history"
                    style="@style/SettingsRow"
                    android:text="🗑️ مسح سجل محادثة Phizyo AI"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <!-- ============== قسم: الحالات المخصصة ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🗂️ الحالات المخصصة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_export"
                    style="@style/SettingsRow"
                    android:text="⬇️ تصدير نسخة احتياطية من حالاتي" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_clear_all"
                    style="@style/SettingsRow"
                    android:text="🗑️ مسح كل الحالات المخصصة"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <!-- ============== قسم: الدعم والمشاركة ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="⭐ الدعم والمشاركة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_share_app"
                    style="@style/SettingsRow"
                    android:text="📤 مشاركة التطبيق" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_rate_app"
                    style="@style/SettingsRow"
                    android:text="⭐ قيّم التطبيق" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_feedback"
                    style="@style/SettingsRow"
                    android:text="✉️ تواصل معنا / أرسل ملاحظات" />
            </LinearLayout>

            <!-- ============== قسم: عن التطبيق ==============
                 دُمج التكرار القديم (عنوان قسم "ℹ️ عن التطبيق" + زر بنفس
                 المعنى "نبذة عن التطبيق والإصدار" بداخله) بحيث تبقى بطاقة
                 واحدة فقط تحت عنوان القسم، بدون عنصر وسيط مكرر. -->
            <TextView
                style="@style/SectionHeader"
                android:text="ℹ️ عن التطبيق" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_about"
                    style="@style/SettingsRow"
                    android:text="نبذة عن التطبيق والإصدار" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_privacy_policy"
                    style="@style/SettingsRow"
                    android:text="🔒 سياسة الخصوصية" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
