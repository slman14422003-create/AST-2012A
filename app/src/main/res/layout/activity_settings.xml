<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة الإعدادات — إعادة تصميم v2: عنوان أكبر بخط serif (زي "Settings" في
     تطبيق Claude)، بطاقة هوية علوية (شعار + اسم + رقم الإصدار)، ومجموعات
     بطاقات نظيفة بعناوين أقسام واضحة بدل الأزرار المتفرقة المتراصة القديمة.
     زر تبديل الوضع الليلي/النهاري بقى صف واحد هنا بس (اتشال من الشاشة
     الرئيسية) بنفس فكرة "Color mode" في إعدادات Claude.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_container"
        app:contentInsetStart="20dp"
        app:navigationIcon="@drawable/ic_close">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="الإعدادات"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============== بطاقة الهوية العلوية ============== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="end"
                        android:text="Phizyo Studio"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_version_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="end"
                        android:textColor="@color/text_tertiary"
                        android:textDirection="rtl"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_avatar_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🩺"
                        android:textSize="20sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- ============== قسم: المظهر ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🌓 المظهر" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_theme_mode"
                    style="@style/SettingsRow"
                    android:text="🌓 حسب إعداد الجهاز" />
            </LinearLayout>

            <!-- ============== قسم: الإشعارات ============== -->
            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="4dp"
                android:text="🔔 الإشعارات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_notif"
                    style="@style/SettingsRow"
                    android:text="🔕 الإشعارات غير مفعّلة - اضغط للتفعيل" />
            </LinearLayout>

            <!-- ============== قسم: Phizyo AI ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="✨ Phizyo AI" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="كيف يعمل Phizyo AI؟"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:text="1️⃣ Phizyo AI نفسه هو اللي بيقرر - لكل رسالة على حدة - هل محتاج يبحث ولا لأ. لو الرسالة دردشة عادية بيرد عليك طبيعي على طول بدون أي بحث.&#10;&#10;2️⃣ لو الرسالة سؤال إكلينيكي فعلي، بيتحقق الأول من قاعدة بيانات الجهاز (130 حالة موثقة) - تطابق مباشر منها يُجاب فورًا وبدقة 100% بدون إنترنت.&#10;&#10;3️⃣ غير كده، يُستخدم بحث Physiopedia أولًا (مرجع متخصص في العلاج الطبيعي)، ثم ويكيبيديا كخلفية معرفية عامة تكميلية لو مفيش نتيجة - والصياغة النهائية دائمًا عبر Phizyo AI، وتلتزم بأي تعليمات مخصّصة تضيفها تحت."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- رابط الووركر ثابت داخل التطبيق (AiClient.FIXED_WORKER_URL) وغير
                 قابل للتعديل من هنا - معروض هنا للشفافية فقط، مع زر اختبار
                 اتصال فوري. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card_soft"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="☁️ المزوّد الثابت (Cloudflare Worker)"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/worker_url_fixed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_test_worker"
                style="@style/PrimaryButton"
                android:layout_marginBottom="22dp"
                android:text="🧪 اختبار الاتصال" />

            <!-- تعليمات مخصّصة لـ Phizyo AI: المستخدم يقدر "يدرّبه" حسب طلبه
                 (أسلوب الإجابة، تركيز معيّن، تفضيلات...) وتُضاف تلقائيًا
                 لتعليمات النظام في كل محادثة (المحادثة الكاملة والرد السريع). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:text="🎓 تعليمات مخصّصة لـ Phizyo AI (اختياري)"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="end"
                android:text="مثال: ركّز دايمًا على التمارين المنزلية، أو اجعل الإجابات مختصرة جدًا بنقاط، أو اسأل عن عمر المريض قبل أي اقتراح."
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="تعليماتك لـ Phizyo AI">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ai_custom_instructions_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3"
                    android:textDirection="rtl" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_save_instructions"
                style="@style/GlassButton"
                android:layout_marginBottom="26dp"
                android:text="✅ حفظ التعليمات" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_clear_chat_history"
                    style="@style/SettingsRow"
                    android:text="🗑️ مسح سجل محادثة Phizyo AI" />
            </LinearLayout>

            <!-- ============== قسم: الحالات المخصصة ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="🗂️ الحالات المخصصة" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_export"
                    style="@style/SettingsRow"
                    android:text="⬇️ تصدير نسخة احتياطية من حالاتي" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_clear_all"
                    style="@style/SettingsRow"
                    android:text="🗑️ مسح كل الحالات المخصصة"
                    android:textColor="@color/accent_red" />
            </LinearLayout>

            <!-- ============== قسم: ميزات إضافية ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="⭐ ميزات إضافية" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_share_app"
                    style="@style/SettingsRow"
                    android:text="📤 مشاركة التطبيق" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_rate_app"
                    style="@style/SettingsRow"
                    android:text="⭐ قيّم التطبيق" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_feedback"
                    style="@style/SettingsRow"
                    android:text="✉️ تواصل معنا / أرسل ملاحظات" />
            </LinearLayout>

            <!-- ============== قسم: عن التطبيق ============== -->
            <TextView
                style="@style/SectionHeader"
                android:text="ℹ️ عن التطبيق" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="4dp">

                <Button
                    android:id="@+id/btn_about"
                    style="@style/SettingsRow"
                    android:text="نبذة عن التطبيق والإصدار" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/glass_border_soft" />

                <Button
                    android:id="@+id/btn_privacy_policy"
                    style="@style/SettingsRow"
                    android:text="🔒 سياسة الخصوصية" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
