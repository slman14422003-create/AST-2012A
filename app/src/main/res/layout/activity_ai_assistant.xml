<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة المساعد الذكي — تصميم مسطّح بالكامل: بدون أي ظل صناعي في أي
     عنصر (الرأس، بانر الشرح، فقاعة الكتابة، قاعدة الإدخال)، فقط تعبئة
     وحدود رفيعة للفصل بين المناطق، بنفس روح Claude الحقيقية.
     كل معرّفات العناصر (IDs) التي يعتمد عليها AiAssistantActivity.java
     أُبقيت كما هي بدون أي تغيير.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <!-- ============== الرأس: مسطّح، بدون ظل ============== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_top_bar_modern"
        android:elevation="0dp"
        app:contentInsetStart="8dp"
        app:navigationIcon="@drawable/ic_close">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- أفاتار مسطح + نقطة حالة خضراء ملتصقة بالزاوية -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="11dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_circle_ai_gradient">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/ai_assistant_name"
                        android:src="@drawable/ic_ai_bot" />
                </FrameLayout>

                <View
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/dot_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Phizyo AI"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="● متصل"
                    android:textColor="@color/accent_green"
                    android:textDirection="rtl"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============== منطقة المحادثة ============== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- بانر "كيف يعمل" مسطّح -->
            <LinearLayout
                android:id="@+id/mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_glass_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_avatar_gradient"
                    android:gravity="center"
                    android:text="✨"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/mode_hint_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:lineSpacingExtra="3dp"
                    android:text="✅ الأسئلة المطابقة لقاعدة بيانات الجهاز تُجاب فورًا بدون إنترنت. غير ذلك، تُصاغ الإجابة عبر Phizyo AI."
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/quick_prompts_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="18dp"
                android:text="💬 جرّب تسأل عن..."
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/quick_prompts_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="14dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/quick_prompts_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- ============== فقاعة الكتابة (Typing Bubble) — مسطّحة ============== -->
        <LinearLayout
            android:id="@+id/typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_glass_card_pressed"
            android:elevation="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp"
            android:paddingVertical="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/typing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="✨ Phizyo AI يفكر..."
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/typing_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />

                <View
                    android:id="@+id/typing_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />

                <View
                    android:id="@+id/typing_dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============== قاعدة الإدخال: مسطّحة، بدون ظل ============== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_dock_modern"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="16dp"
            android:paddingVertical="5dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_send"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="إرسال"
                android:src="@drawable/ic_send"
                app:backgroundTint="?attr/colorPrimary"
                app:borderWidth="0dp"
                app:elevation="0dp"
                app:fabCustomSize="42dp"
                app:maxImageSize="18dp"
                app:pressedTranslationZ="0dp"
                app:tint="@color/white" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="11dp"
                android:background="@android:color/transparent"
                android:gravity="end"
                android:hint="اسأل عن حالة، عرض، أو أي استفسار طبي..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
