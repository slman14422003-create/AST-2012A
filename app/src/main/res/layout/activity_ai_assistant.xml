<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة المساعد الذكي — إعادة تصميم شاملة: رأس بهوية شخصية (شارة + حالة
     اتصال)، بانر حالة بشارة أيقونة، فقاعة كتابة حقيقية، وقاعدة إدخال
     بأسلوب "كبسولة واحدة" (حقل + زر إرسال داخل نفس الحاوية) بدل عنصرين
     منفصلين متراكبين، بنفس روح تطبيقات المحادثة الحديثة.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/bg_header_container"
        app:contentInsetStart="8dp"
        app:navigationIcon="@drawable/ic_close">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle_ai" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🤖"
                    android:textSize="17sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phizyo AI"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● متصل · Physiopedia + قاعدة الجهاز"
                    android:textColor="@color/accent_green"
                    android:textDirection="rtl"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_border_soft" />

    <LinearLayout
        android:id="@+id/mode_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_glass_card_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="ℹ️"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mode_hint_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="🤖 يعمل حاليًا بالوضع المجاني الجاهز (بدون مفتاح). يمكنك إضافة مفتاح OpenRouter اختياري من الإعدادات لتجربة نموذج بديل."
            android:textColor="@color/text_secondary"
            android:textDirection="rtl"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_prompts_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="14dp"
        android:text="💬 جرّب تسأل عن..."
        android:textColor="@color/text_tertiary"
        android:textDirection="rtl"
        android:textSize="11sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/quick_prompts_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/quick_prompts_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp" />

    <!-- ============== فقاعة الكتابة (Typing Bubble) ============== -->
    <LinearLayout
        android:id="@+id/typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_card_pressed"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/typing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🤖 Phizyo AI يفكر..."
            android:textColor="@color/text_secondary"
            android:textDirection="rtl"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/typing_dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/dot_accent" />

            <View
                android:id="@+id/typing_dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/dot_accent" />

            <View
                android:id="@+id/typing_dot_3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/dot_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============== قاعدة الإدخال: كبسولة واحدة بأسلوب تطبيقات المحادثة
         الحديثة (الحقل وزر الإرسال داخل نفس الحاوية، بدل عنصرين متراكبين) ============== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_container"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp"
            android:paddingVertical="4dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="إرسال"
                android:src="@drawable/ic_send"
                app:backgroundTint="?attr/colorPrimary"
                app:borderWidth="0dp"
                app:elevation="0dp"
                app:fabCustomSize="40dp"
                app:maxImageSize="17dp"
                app:pressedTranslationZ="1dp"
                app:tint="@color/white" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:background="@android:color/transparent"
                android:gravity="end"
                android:hint="اسأل عن حالة، عرض، أو أي استفسار طبي..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
