<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة المساعد الذكي — تصميم v4:
     1) رأس على شكل بطاقة عائمة دقيقة (مسافة حولها + حدّ رفيع) بدل شريط
        ملتصق بحواف الشاشة.
     2) زر الإرسال منفصل تمامًا عن شريط الإدخال (دائرة مستقلة بجانبه بفاصل
        واضح) بدل الاثنين داخل نفس الكبسولة.
     3) الاقتراحات السريعة أصبحت في تركيبة ترحيبية منسّقة تتمركز عموديًا
        في منتصف مساحة المحادثة (تظهر فوق القائمة الفارغة) بدل شريط
        أفقي ملتصق أعلى الشاشة.
     4) صفر ظل في كل عنصر: stateListAnimator=null + elevation=0dp على كل
        أزرار FAB، وخلفيات مسطحة (تعبئة + حدّ) في كل مكان.
     كل معرّفات العناصر (IDs) التي يعتمد عليها AiAssistantActivity.java
     أُبقيت كما هي بدون أي تغيير.
     ============================================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <!-- ============== الرأس: بطاقة عائمة دقيقة ============== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="0dp"
        app:contentInsetStart="10dp"
        app:contentInsetEnd="6dp"
        app:navigationIcon="@drawable/ic_close">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- أفاتار مسطح + نقطة حالة خضراء ملتصقة بالزاوية -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_avatar_circle_ai_gradient">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/ai_assistant_name"
                        android:src="@drawable/ic_ai_bot" />
                </FrameLayout>

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/dot_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Phizyo AI"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="● متصل"
                    android:textColor="@color/accent_green"
                    android:textDirection="rtl"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============== منطقة المحادثة ============== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- بانر "كيف يعمل" مسطّح - ثابت أعلى منطقة المحادثة -->
        <LinearLayout
            android:id="@+id/mode_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_card_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="visible">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_avatar_gradient"
                android:gravity="center"
                android:text="✨"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mode_hint_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:lineSpacingExtra="3dp"
                android:text="✅ الأسئلة المطابقة لقاعدة بيانات الجهاز تُجاب فورًا بدون إنترنت. غير ذلك، تُصاغ الإجابة عبر Phizyo AI."
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- قائمة الرسائل -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="80dp"
            android:paddingBottom="12dp" />

        <!-- ============== الاقتراحات السريعة: تركيبة ترحيبية متمركزة
             في منتصف مساحة المحادثة (تظهر فقط والمحادثة فاضية) ============== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/quick_prompts_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="💬 جرّب تسأل عن..."
                android:textColor="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/quick_prompts_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/quick_prompts_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ============== فقاعة الكتابة (Typing Bubble) — مسطّحة ============== -->
        <LinearLayout
            android:id="@+id/typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_glass_card_pressed"
            android:elevation="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp"
            android:paddingVertical="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/typing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="✨ Phizyo AI يفكر..."
                android:textColor="@color/text_secondary"
                android:textDirection="rtl"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/typing_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />

                <View
                    android:id="@+id/typing_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />

                <View
                    android:id="@+id/typing_dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/dot_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- خط فاصل رفيع بين منطقة المحادثة وقاعدة الإدخال -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_border_soft" />

    <!-- ============== قاعدة الإدخال: حقل الكتابة + زر إرسال منفصل تمامًا ============== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_dock_modern"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- زر الإرسال: دائرة مستقلة تمامًا، بفاصل واضح عن الحقل، بدون أي ظل -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:contentDescription="إرسال"
            android:src="@drawable/ic_send"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary_cyan"
            app:borderWidth="0dp"
            app:elevation="0dp"
            app:fabCustomSize="46dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:maxImageSize="19dp"
            app:pressedTranslationZ="0dp"
            app:rippleColor="#30FFFFFF"
            app:tint="@color/white" />

        <!-- حقل الإدخال: كبسولة مستقلة بحدّ رفيع، بدون أي زر بداخلها -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="46dp"
            android:paddingHorizontal="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="end|center_vertical"
                android:hint="اسأل عن حالة، عرض، أو أي استفسار طبي..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textDirection="rtl"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
