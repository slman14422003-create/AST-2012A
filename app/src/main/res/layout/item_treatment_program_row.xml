<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة برنامج علاج في القائمة (تفتح شاشة التفاصيل عند الضغط) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/program_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card_pressed"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/program_title"
        style="@style/Phizyo.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/program_diagnosis"
        style="@style/Phizyo.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_source_chip"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/m3_on_primary_container"
        android:textDirection="rtl"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/program_goals"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/glass_border_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/program_btn_edit"
            style="@style/Phizyo.ActionText"
            android:drawableStart="@drawable/ic_edit"
            android:text="تعديل" />

        <TextView
            android:id="@+id/program_btn_delete"
            style="@style/Phizyo.ActionText"
            android:drawableStart="@drawable/ic_trash"
            android:drawableTint="@color/accent_red"
            android:text="حذف"
            android:textColor="@color/accent_red" />

        <TextView
            android:id="@+id/program_date"
            style="@style/Phizyo.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:textAlignment="viewEnd" />
    </LinearLayout>
</LinearLayout>
