<?xml version="1.0" encoding="utf-8"?>
<!-- نافذة حساب النسخ السحابي: بريد + كلمة مرور (تسجيل دخول / إنشاء حساب) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/acc_message"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سجّل الدخول بحسابك لتستعيد ملفات المرضى حتى بعد حذف التطبيق أو تغيير الجهاز." />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Phizyo.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="البريد الإلكتروني">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/acc_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Phizyo.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="كلمة المرور (6 أحرف أو أكثر)"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/acc_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/acc_error"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/accent_red"
        android:visibility="gone" />

    <TextView
        android:id="@+id/acc_forgot"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="4dp"
        android:text="نسيت كلمة المرور؟"
        android:textColor="@color/primary_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/acc_login"
            style="@style/Phizyo.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="تسجيل الدخول" />

        <TextView
            android:id="@+id/acc_register"
            style="@style/Phizyo.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="حساب جديد" />
    </LinearLayout>

    <TextView
        android:id="@+id/acc_cancel"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="إلغاء" />
</LinearLayout>
