<?xml version="1.0" encoding="utf-8"?>
<!-- رقاقة "إعداد سريع" واحدة (مثال: 🎯 النمط / TENS) - تُستخدم في شبكة
     2×2 أعلى شاشة تفاصيل الحالة لعرض النمط والتردد والقناة والمدة بشكل
     مجمّع وسريع المسح، بدل 4 بطاقات كاملة العرض منفصلة كانت متطابقة
     الشكل مع كل حقل وصفي تاني في الشاشة. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_stat_chip"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:textColor="@color/primary_cyan_dark"
        android:textDirection="rtl"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textDirection="rtl"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>
