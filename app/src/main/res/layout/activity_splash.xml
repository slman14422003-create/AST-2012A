<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة splash متقدمة: خلفية برتقالية مصمتة بنفس لون Claude تمامًا
     (claude_orange)، علامة "نبضة" بيضاء بتدخل بحركة scale+fade من
     SplashActivity ثم تنبض بهدوء (إحساس دقة قلب)، اسم التطبيق بخط serif،
     وسطر وصف قصير، ومؤشر تحميل بثلاث نقاط بيضاء نابضة أسفل الشاشة.
     ============================================================================ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/claude_orange">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:fontFamily="serif"
            android:letterSpacing="0.01"
            android:text="Phizyo Studio"
            android:textColor="@color/white"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:gravity="center"
            android:text="مساعد العلاج الطبيعي الذكي"
            android:textColor="#F4E4DB"
            android:textDirection="rtl"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/splash_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/dot_white" />

        <View
            android:id="@+id/splash_dot_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/dot_white" />

        <View
            android:id="@+id/splash_dot_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/dot_white" />
    </LinearLayout>
</FrameLayout>
