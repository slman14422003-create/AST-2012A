<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     شاشة splash بأسلوب Claude:
     * خلفية بلون خلفية التطبيق (داكنة في الليلي، كريمية في النهاري)
     * في المنتصف: علامة النجمة البرتقالية + اسم التطبيق بخط serif
     * أسفل الشاشة: اسم المطوّر PT Slman بحروف متباعدة رمادية (مثل ANTHROPIC)
     ============================================================================ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_1">

    <!-- الشعار: ثابت اتجاهه LTR (علامة يسار الاسم) بغض النظر عن اتجاه الواجهة -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_splash_mark" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:alpha="0"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:text="Phizyo Studio"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:alpha="0"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:text="PT Slman"
        android:textColor="@color/text_tertiary"
        android:textDirection="ltr"
        android:textSize="17sp" />
</FrameLayout>
