<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة ملف واحد في قائمة "الملفات السحابية" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card_pressed"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/primary_cyan" />

        <TextView
            android:id="@+id/row_title"
            style="@style/Phizyo.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_meta"
        style="@style/Phizyo.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/glass_border_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_rename"
            style="@style/Phizyo.ActionText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_edit"
            android:text="تسمية" />

        <TextView
            android:id="@+id/btn_replace"
            style="@style/Phizyo.ActionText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_refresh"
            android:text="استبدال" />

        <TextView
            android:id="@+id/btn_delete"
            style="@style/Phizyo.ActionText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_trash"
            android:drawableTint="@color/accent_red"
            android:text="حذف"
            android:textColor="@color/accent_red" />
    </LinearLayout>
</LinearLayout>
