<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة ملف واحد في قائمة "الملفات السحابية": اسم + حجم/تاريخ، وصف إجراءات
     أنيق بأربعة أزرار متساوية (فتح / تسمية / استبدال / حذف) بفواصل رأسية رفيعة
     وأيقونة فوق تسمية كل زر، بدل نص وأيقونة متجاورين بلا فواصل. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card_pressed"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/primary_cyan" />

        <TextView
            android:id="@+id/row_title"
            style="@style/Phizyo.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_meta"
        style="@style/Phizyo.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/glass_border_soft" />

    <!-- شريط الإجراءات: أربع خلايا متساوية بفواصل رأسية دقيقة بينها -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_download"
                android:tint="@color/primary_cyan_dark" />

            <TextView
                style="@style/Phizyo.ActionLabel"
                android:layout_marginTop="6dp"
                android:text="فتح" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/glass_border_soft" />

        <LinearLayout
            android:id="@+id/btn_rename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                android:tint="@color/primary_cyan_dark" />

            <TextView
                style="@style/Phizyo.ActionLabel"
                android:layout_marginTop="6dp"
                android:text="تسمية" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/glass_border_soft" />

        <LinearLayout
            android:id="@+id/btn_replace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh"
                android:tint="@color/primary_cyan_dark" />

            <TextView
                style="@style/Phizyo.ActionLabel"
                android:layout_marginTop="6dp"
                android:text="استبدال" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/glass_border_soft" />

        <LinearLayout
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_trash"
                android:tint="@color/accent_red" />

            <TextView
                style="@style/Phizyo.ActionLabel"
                android:layout_marginTop="6dp"
                android:text="حذف"
                android:textColor="@color/accent_red" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
