<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/anatomy_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_accent"
        android:textAlignment="viewStart"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textDirection="rtl"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anatomy_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="viewStart"
        android:textColor="@color/text_primary"
        android:textDirection="rtl"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anatomy_nerve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="viewStart"
        android:textColor="@color/primary_cyan_dark"
        android:textDirection="rtl"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/anatomy_landmarks_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="viewStart"
        android:text="مواضع الأقطاب"
        android:textColor="@color/text_tertiary"
        android:textDirection="rtl"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/anatomy_landmarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textAlignment="viewStart"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textDirection="rtl"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/anatomy_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card_soft"
        android:textAlignment="viewStart"
        android:padding="10dp"
        android:textColor="@color/accent_gold"
        android:textDirection="rtl"
        android:textSize="11sp" />
</LinearLayout>
