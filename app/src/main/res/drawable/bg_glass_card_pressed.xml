<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة/زر مسطّح بزوايا مدوّرة مع تأثير ripple عند الضغط فقط.
     كان في السابق شكل بيضاوي (oval) وده كان بيخلّي الصفوف العريضة
     (المرضى، حالاتي، برامج العلاج) تظهر كأنها إهليلج - صار مستطيل مدوّر. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_highlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</ripple>
