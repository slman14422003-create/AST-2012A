<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_highlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_soft" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="@color/glass_fill_strong"
                        android:endColor="@color/glass_fill" />
                    <stroke android:width="1dp" android:color="@color/glass_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
