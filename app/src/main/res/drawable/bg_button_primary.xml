<?xml version="1.0" encoding="utf-8"?>
<!-- زر رئيسي موحّد (CTA): تدرج سيان -> بنفسجي، حواف كبسولة كاملة -
     يُستخدم لكل أزرار الحفظ/الإرسال/الإضافة الرئيسية في التطبيق عشان
     تبقى كلها بنفس الهوية البصرية. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_highlight">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/primary_cyan"
                android:endColor="@color/accent_violet" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
