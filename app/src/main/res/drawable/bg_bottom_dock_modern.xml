<?xml version="1.0" encoding="utf-8"?>
<!-- الرصيف السفلي الجديد: زوايا علوية أوسع (28dp) + حدّ رفيع محيط بالكامل
     (بدل الاعتماد على الظل فقط) حتى يبان كبطاقة مرفوعة واضحة عن الخلفية،
     خصوصًا في الوضع النهاري حيث يكون تباين الظل ضعيف. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill_strong" />
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke android:width="1dp" android:color="@color/glass_border_soft" />
</shape>
