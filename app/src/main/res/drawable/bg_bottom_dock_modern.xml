<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_strong"/>
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90"
                android:startColor="@color/glass_fill" android:endColor="@color/glass_fill_strong"/>
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
            <stroke android:width="1dp" android:color="@color/glass_border_soft"/>
        </shape>
    </item>
</layer-list>