<?xml version="1.0" encoding="utf-8"?>
<!-- الشريط العلوي v4: طبقة ظل ممتدة أسفل البطاقة (تحاكي إسقاط ضوئي ناعم)
     + سطح بتدرج علوي خفيف (لمعة) بدل التعبئة المسطحة الواحدة. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_fill_strong"
                android:endColor="@color/glass_fill" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
