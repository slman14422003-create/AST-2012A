<?xml version="1.0" encoding="utf-8"?>
<!-- رأس الشاشة: مسطح تمامًا (بدون زوايا دائرية سفلية) بحدّ سفلي رفيع -
     مطابق لشريط علوي Claude النظيف. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
