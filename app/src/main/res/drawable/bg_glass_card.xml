<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة زجاجية v2: تراكب شبه شفاف + حدّ ناعم + خط علوي لامع (sheen) رفيع
     يحاكي انعكاس الضوء على سطح زجاجي حقيقي — إحساس Glassmorphism أوضح. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_top_sheen" />
        </shape>
    </item>
</layer-list>
