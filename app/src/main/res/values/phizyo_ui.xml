<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     أنماط موحّدة لشاشات: تفاصيل الحالة، حالاتي، المرضى، برامج العلاج.

     ملاحظة مهمة عن المحاذاة: النمط القديم (gravity=end + textDirection=rtl) كان
     يلصق النص العربي بالحافة اليسرى بدل اليمنى، لأن "end" في فقرة RTL معناها
     "عكس بداية الفقرة" = اليسار. هنا نستخدم textAlignment=viewStart، فيلتصق النص
     بحافة بداية الواجهة (اليمين) دائمًا، مهما كان اتجاه الفقرة أو محتواها.
     ============================================================================ -->
<resources>

    <!-- عنوان الشاشة داخل الشريط العلوي (نفس روح عنوان الإعدادات) -->
    <style name="Phizyo.HeaderTitle" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Phizyo.HeaderSubtitle" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- عنوان الصفحة الكبير داخل المحتوى -->
    <style name="Phizyo.HeroTitle" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- عنوان قسم -->
    <style name="Phizyo.SectionTitle" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- نص أساسي -->
    <style name="Phizyo.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="Phizyo.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Phizyo.Caption" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- تسمية صغيرة فوق قيمة (مثل: التردد) -->
    <style name="Phizyo.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <!-- شريحة (كبسولة) قابلة للضغط -->
    <style name="Phizyo.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_glass_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textDirection">rtl</item>
    </style>

    <!-- زر رئيسي (تعبئة طوبية) -->
    <style name="Phizyo.Button.Primary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">rtl</item>
    </style>

    <!-- زر ثانوي (بطاقة بحدّ رفيع) -->
    <style name="Phizyo.Button.Secondary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_glass_card_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textDirection">rtl</item>
    </style>

    <!-- إجراء نصي صغير داخل البطاقات (تعديل / حذف) -->
    <style name="Phizyo.Button.Text" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/primary_cyan_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">rtl</item>
    </style>

    <!-- شارة صغيرة (TENS / EMS / مخصص) -->
    <style name="Phizyo.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <!-- بطاقة إحصائية صغيرة في رأس شاشة المرضى -->
    <style name="Phizyo.StatValue" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- حقل إدخال مخطّط بحدود ناعمة (نفس ألوان التطبيق) -->
    <style name="Phizyo.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/glass_fill_soft</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxStrokeColor">@color/primary_cyan</item>
        <item name="hintTextColor">@color/text_tertiary</item>
    </style>
</resources>
