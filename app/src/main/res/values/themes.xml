<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ClinicalMaster" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_cyan</item>
        <item name="colorPrimaryVariant">@color/primary_cyan_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_cyan</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <!-- كان هنا الخلل: شريط الحالة كان بلون bg_dark بينما كل الأشرطة العلوية
             (Toolbar) بلون surface_dark - لونين مختلفين فعليًا، وده اللي كان
             بيبين كخط فاصل غير منسق أعلى الشاشة. دلوقتي بنفس لون الشريط العلوي
             تمامًا فيبقوا قطعة واحدة متصلة بصريًا. -->
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- عنوان قسم داخل شاشة الإعدادات (أو أي شاشة تحتاج تقسيم بصري لمجموعات
         من الخيارات) - لون مميز، خط عريض، محاذاة لليمين للعربي. -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/primary_cyan</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
